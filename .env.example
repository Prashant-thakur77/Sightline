# Copy to .env.local and fill in. Missing optional keys switch that feature off; the app says so
# instead of faking it.

# ---------- Required to start ----------
PRODUCT_NAME=Sightline
APP_URL=http://localhost:3100
NODE_ENV=development
DATABASE_URL=postgres://sightline:sightline@localhost:5442/sightline
VISION_SERVICE_URL=http://localhost:8011
# Secrets: generate each with `openssl rand -hex 32`
SESSION_SECRET=
HELPER_LINK_SECRET=
# 64 hex characters; receipts and evidence packs are signed with it (`openssl rand -hex 32`)
RECEIPT_SIGNING_KEY=
# Bearer token for POST /api/maintenance (`openssl rand -hex 24`)
MAINTENANCE_TOKEN=

# ---------- PayPal sandbox (needed to buy anything) ----------
# The app refuses to start unless these two point at the sandbox.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# developer.paypal.com → Apps & Credentials → Sandbox → create an app (REST API)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox business account the app belongs to (Sandbox accounts → the business account → Account ID)
PAYPAL_MERCHANT_ID=
# Only for a public URL: create a webhook for <APP_URL>/api/webhooks/paypal and paste its id
PAYPAL_WEBHOOK_ID=
# A sandbox personal (buyer) account, used by the spike scripts and the buyer side of disputes
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_BUYER_PAYER_ID=
# Optional: a saved PayPal (vault id) for that buyer, so demo shoppers pay by voice without the
# PayPal window. Create it once with `packages/paypal/spikes/run.ts s2-vault`.
DEMO_VAULT_ID=

# ---------- AI (the camera check's second size reader, the second confirmation key, questions) ----------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
VISION_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5

# ---------- Optional ----------
# Streaming speech to text (the browser's own speech recognition is used without it)
DEEPGRAM_API_KEY=
# Live product data instead of the built-in Demo Store catalog
CHANNEL3_API_KEY=
# Read-only cloud browser for reading store pages
KERNEL_API_KEY=
# AG Studio licence (without it the dashboards show a trial watermark outside localhost)
AG_STUDIO=
# Web push notifications (`pnpm --filter @sightline/web exec web-push generate-vapid-keys`)
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
